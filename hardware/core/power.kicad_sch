	(text "Battery and charger (CORE-001...006). BQ25628E charges the 1-cell LiPo from VBUS and powers SYS through its power path.\nILIM = 5.1 kOhm limits input to 490 mA until firmware reads the USB-C current advertisement (CC1/CC2) and raises IINDPM.\nTS network RT1 5.23 kOhm / RT2 30.1 kOhm for a 103AT 10 kOhm NTC taped to the cell (J102). MAX17048 at I2C 0x36, charger at 0x6A."
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "122bb637-c86e-580c-b6e1-634fc010118c")
	)
